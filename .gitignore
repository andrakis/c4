node_modules/
# All anchored to the root. These are build outputs, but a bare name
# also matches any DIRECTORY of that name at any depth -- "c4cc" was
# hiding the whole of src/c4cc/, so a new file added there would have
# been invisible to git rather than merely untracked. Tracked files
# survived, which is why it went unnoticed.
/c4
/c4.o
/c4cc
/cpp
/c4cc.o
/c4m
/c4m.o
/c4mp
/c4mp.o
.c4mp_*.c4o
u0.c4l
libc4ix.c4l
.cx_*

/c4rdump
/c4rlink
/c4sp

# c4bb (the breadboard computer): 32-bit native toolchain builds, and
# the whole images/ tree, which build-images.sh regenerates from
# source (src/c4bb/fs/*.vfs.txt is the actual source and lives outside
# this directory on purpose, so it survives `rm -rf images/`).
/c4cc32
/c4m32
/c4rlink32
/c4sp32
src/c4bb/images/
c4or1k-native
/c4dos-disk/
/c4dos-disk32/
/c4dos-build/
/c4dos-c4th/
/c4ke-src.tar

# scratch directories the test scripts create and trap-remove
.c4dos_test_tmp/
.ladder_test_tmp/
/c4th
# generated by src/c4th/bench/fuse-probe.sh when TMPDIR is unset in-tree
/c4m-fuse
