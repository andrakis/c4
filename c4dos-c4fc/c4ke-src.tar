#define kern_tasks_running()          0
#define kern_user_start_c4r(argc, argv, name, privileges) __c4_opcode(privileges, name, argv, argc, OP_USER_START_C4R)
#define kern_request_exclusive()      __c4_opcode(OP_KERN_REQUEST_EXCLUSIVE)
#define kern_release_exclusive()      __c4_opcode(OP_KERN_RELEASE_EXCLUSIVE)
