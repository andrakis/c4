# install.lst -- what makes a bootable C4KE medium.
#
# Read by `RUN install.c4r B:` (src/c4dos/install.c). Every name is
# fetched from wherever it actually is: C4DOS looks in the RAM disk
# before the disk, so anything LADDER.BAT just compiled shadows the
# copy that shipped on this floppy. That precedence is the point --
# the medium gets the kernel THIS machine built, not the one it was
# handed.
#
# `boot NAME` names the image the BIOS is to load and is copied like
# any other entry; a leading `?` means copy it if it is there.
#
# See docs/c4bb-storage.md M11.

# --- the system itself, both built by LADDER.BAT ---------------------
boot c4ke.c4r
init.c4r

# --- the shell and the userland --------------------------------------
# Without these the kernel comes up with nothing to run in it, which is
# the mistake the climb disk made before M9.
c4sh.c4r
c4ke.vfs.c4r
# vfsload and its manifest are what give the booted system a source
# tree instead of a bare root. The manifest names more than any one
# medium carries; vfsload loads what it finds and says how many.
vfsload.c4r
c4ke.vfs.txt
ls.c4r
ps.c4r
top.c4r
cat.c4r
echo.c4r
type.c4r
xxd.c4r
kill.c4r
spin.c4r
c4le.c4r
reboot.c4r

# --- something to do with it -----------------------------------------
mandel.c4r
rps.c4r
raycast.c4r
bench.c4r
benchtop.c4r
innerbench.c4r
c4.c4r
c4m.c4r

# --- what the NEXT rung is built from ---------------------------------
# tar unpacks these inside C4KE; b4ke drives the compiles and c4rlink
# joins the objects. c4sc is the compiler c4ix.b4k calls.
tar.c4r
save.c4r
b4ke.c4r
c4sc.c4r
c4rlink.c4r
c4ix.b4k
c4ix.objs
c4ix-src.tar
tools-src.tar
c4ke-src.tar

# --- the tool that does this one rung up -------------------------------
# kinstall is this program's counterpart as a C4KE task: after b4ke
# builds C4IX, it reads c4ix.lst and writes the next medium. Both have
# to be HERE, because this floppy is the last thing in the chain that
# has them.
kinstall.c4r
c4ix.lst

# --- C4IX's userland ---------------------------------------------------
# The kernel C4KE builds has no way to make these: libc4ix is a separate
# ladder. init spawns c4ix-vfsload.c4r and then c4ix-sh.c4r with no
# arguments at all, so those two are what "bootable" means for C4IX.
c4ix-vfsload.c4r
c4ix-sh.c4r
c4ix.vfs.txt
c4ix-ls.c4r
c4ix-cat.c4r
c4ix-ps.c4r
c4ix-top.c4r
c4ix-echo.c4r
c4ix-wc.c4r
c4ix-mkdir.c4r
c4ix-hello.c4r
c4ix-uhello.c4r
c4ix-bench.c4r
c4ix-cycles.c4r
c4ix-spin.c4r
c4ix-fmt.c4r

# --- innerbench's inputs, by the exact names it opens them with -------
# innerbench's DEFAULT mode is ONLY_C4M|ONLY_DIRECT, which invokes
#   c4m load-c4r.c src/c4ke/c4ke.c -- -v 0 bench
# so the kernel source is wanted under that exact path, slashes and all.
# It was missing here, so innerbench worked on the directory-backed
# disks (which have src/c4ke/c4ke.c) and failed on any medium install
# wrote -- the one a player actually boots.
load-c4r.c
c4m.c
src/c4ke/c4ke.c

# --- optional: only there if this session got that far -----------------
?c4ke0.c4r
?c4cc2.c4r
?cpp2.c4r
